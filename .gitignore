experiments/results/
experiments/results_*/
*.log

# Nothing from the internal build belongs here. These paths exist so that a
# stray copy of the working repository cannot be committed by accident:
# they carry the monitoring configuration, the internal-to-public column
# mapping and the anonymisation salt.
release/private/
release/dist/
release/column_names.py
release/release_column_names.csv
release/anonymize.py
release/generate_synthetic.py
release/schema_docs.py
release/make_data_dictionary.py
release/profile_columns.py
release/make_code_package.py
release/common.py
release/validate.py
release/column_inventory*
extraction/
pipeline/extend_dataset.*
pipeline/run_pipeline.sh
pipeline/sql/
experiments/ALIGNMENT_REBUILD.md
experiments/diagnose_previous_gain*.py
requirements.txt

